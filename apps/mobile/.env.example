# Mobile app environment variables
# Copy this file to .env and fill in the values for your local setup.
#
#   cp .env.example .env
#
# All variables must be prefixed with EXPO_PUBLIC_ so the Expo bundler
# injects them into the JavaScript bundle at build time.
# Never put secrets or private keys in EXPO_PUBLIC_* variables —
# they are visible to anyone who downloads the app.

# ── Backend API ────────────────────────────────────────────────────────────────
# Base URL of the Agora REST API (no trailing slash, no /api/v1 suffix).
# The app appends /api/v1/<path> itself.
#
# Simulator / emulator shortcuts:
#   iOS Simulator           http://localhost:3001
#   Android Emulator        http://10.0.2.2:3001   (10.0.2.2 = host loopback)
#   Physical device (Wi-Fi) http://<your-local-IP>:3001
EXPO_PUBLIC_API_URL=http://localhost:8080

# ── WebSocket ──────────────────────────────────────────────────────────────────
# WebSocket base URL for real-time purchase and organizer events.
# Must use ws:// for local dev (wss:// in production).
# Used by utils/websocket.ts (purchase stream) and app/organizer/dashboard.tsx.
#
# Same host/port rules as EXPO_PUBLIC_API_URL apply.
EXPO_PUBLIC_WS_URL=ws://localhost:8080

# ── Stellar / Soroban ──────────────────────────────────────────────────────────
# Soroban RPC endpoint used to simulate and submit on-chain transactions.
# The default points at Stellar Testnet and is safe for local development.
# Override with a local `stellar quickstart` node URL if you need a fully
# offline environment (e.g. http://localhost:8000/soroban/rpc).
EXPO_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar Testnet contract address for the ticket_payment Soroban contract.
# The value below is the testnet deployment used during development.
# Replace with the correct contract ID if you deploy your own instance.
EXPO_PUBLIC_TICKET_PAYMENT_CONTRACT_ID=CBQHNAXSI55GX2GN6D67GK7BHVPSLJUGZQEU7WJ5LKR5PNUCGLIMAO4K
