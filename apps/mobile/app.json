{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F10"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F0F10"
      },
      "statusBar": {
        "barStyle": "light-content",
        "backgroundColor": "#0F0F10",
        "translucent": false
      }
    },
    "web": {
      "bundler": "metro",
      "output": "spa",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Agora uses the camera to scan attendee ticket QR codes at the gate."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
