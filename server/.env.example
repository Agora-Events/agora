# Server Configuration
# Port on which the API server should listen (must be 1–65535)
# Default: 3001
PORT=3001

# Database Configuration
# PostgreSQL connection string (REQUIRED)
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=postgres://user:password@localhost:5432/agora

# Environment Settings
# Set to "production" for production deployments (enables HSTS, stricter security)
# Valid values: development, staging, testing, production
# Default: development
RUST_ENV=development

# Logging Configuration
# Log level for the application using tracing-subscriber
# Valid values: trace, debug, info, warn, error, off
# Crate-specific filters are also accepted (e.g. agora_server=debug,info)
# Default: info
RUST_LOG=info

# CORS Configuration
# Comma-separated list of allowed origins for Cross-Origin Resource Sharing.
# Each entry must be a valid URL. In production ALL origins must use HTTPS.
# Example: https://agora.events,https://www.agora.events
# Default: http://localhost:3000,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Soroban RPC health probe URL (must be a valid URL)
# Used by GET /api/v1/health/blockchain to check blockchain connectivity
# Default: https://soroban-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Redis connection string, used to cache GET /api/v1/rates responses
# If unset, the rates endpoint always fetches fresh from the provider
REDIS_URL=redis://localhost:6379

# External exchange rate provider base URL used by GET /api/v1/rates
# Default: https://api.exchangerate.host/latest
RATES_PROVIDER_URL=https://api.exchangerate.host/latest

# Bearer token required to access GET /api/v1/monitoring
# If unset, the monitoring endpoint rejects all requests
MONITORING_API_KEY=
