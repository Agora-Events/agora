# Server Configuration
# Port on which the API server should listen (must be 1–65535)
# Default: 3001
PORT=3001

# Database Configuration
# PostgreSQL connection string (REQUIRED)
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=postgres://user:password@localhost:5432/agora

# Environment Settings
# Set to "production" for production deployments (enables HSTS, stricter security)
# Valid values: development, staging, testing, production
# Default: development
RUST_ENV=development

# Logging Configuration
# Log level for the application using tracing-subscriber
# Valid values: trace, debug, info, warn, error, off
# Crate-specific filters are also accepted (e.g. agora_server=debug,info)
# Default: info
RUST_LOG=info

# CORS Configuration
# Comma-separated list of allowed origins for Cross-Origin Resource Sharing.
# Each entry must be a valid URL. In production ALL origins must use HTTPS.
# Example: https://agora.events,https://www.agora.events
# Default: http://localhost:3000,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Soroban RPC health probe URL (must be a valid URL)
# Used by GET /api/v1/health/blockchain to check blockchain connectivity
# Default: https://soroban-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Redis Configuration (must be a valid URL)
# Redis connection URL for caching popular events
# Default: redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

# Application base URL (must be a valid URL)
# Default: https://agora.events
BASE_URL=https://agora.events

# JWT Authentication
# HMAC secret for signing JWTs.
# REQUIRED in production and must be at least 32 characters long.
# In development a built-in fallback is used if this is not set.
JWT_SECRET=change-me-to-a-long-random-secret-in-production

# S3 / Cloudflare R2 Image Uploads
# All four variables below must be set together, or all left unset.
# Leaving them unset disables image uploads without error.
# S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, and S3_PUBLIC_URL
# must all be provided to enable uploads.
#
# S3_PUBLIC_URL must be a valid URL (e.g. https://cdn.agora.events)
# S3_ENDPOINT_URL is required for Cloudflare R2 and must be a valid URL.
# Setting S3_ENDPOINT_URL without S3_BUCKET is a configuration error.
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_PUBLIC_URL=
