# Server Configuration
# Port on which the API server should listen
# Default: 3001
PORT=3001

# Database Configuration
# PostgreSQL connection string
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=postgres://user:password@localhost:5432/agora

# Environment Settings
# Set to "production" for production deployments (enables HSTS, stricter security)
# Default: development
RUST_ENV=development

# Logging Configuration
# Log level for the application using tracing-subscriber
# Available levels: trace, debug, info, warn, error
# Default: info (recommended for general use)
RUST_LOG=info

# CORS Configuration
# Comma-separated list of allowed origins for Cross-Origin Resource Sharing
# Example: http://localhost:3000,https://agora.example.com
# Default: http://localhost:3000,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# S3 / Cloudflare R2 Configuration
# Bucket name for image uploads
S3_BUCKET=agora-images
# Region: use "us-east-1" for AWS S3, "auto" for Cloudflare R2
S3_REGION=auto
# Access credentials
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# Custom endpoint URL — required for Cloudflare R2, omit for AWS S3
# Example R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# Public base URL used to build the returned image URL
# Example: https://images.agora.example.com  or  https://pub-<id>.r2.dev
S3_PUBLIC_URL=https://images.agora.example.com
